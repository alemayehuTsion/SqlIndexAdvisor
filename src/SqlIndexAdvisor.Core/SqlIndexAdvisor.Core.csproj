<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Collection\Sql\*.sql" LogicalName="Sql.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
